# ─────────────────────────────────────────────────────────────────────────
# Amellify v3 — environment variables
# Copy this file to `.env` and fill in the values. See docs/DEPLOY.md for
# a full self-hosting walkthrough.
# ─────────────────────────────────────────────────────────────────────────

# --- Database (required) -----------------------------------------------
# Self-hosted Postgres. When using docker-compose.yml as-is, this matches
# the `db` service credentials — change the password before going to prod.
DATABASE_URL=postgresql://amellify:amellify@localhost:5432/amellify

# --- Auth (required) -----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL this instance is reachable at. No domain yet? Use your
# server's IP, e.g. http://203.0.113.10:3000 — see docs/DEPLOY.md for the
# free sslip.io + Caddy HTTPS shortcut once you're ready for a domain.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OAuth providers (optional) ------------------------------------------
# GitHub OAuth works fine over plain HTTP/IP. Leave unset to hide the
# button on the login page.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth REQUIRES HTTPS + a real domain — it will not work by IP.
# Leave unset until you have a domain (see docs/DEPLOY.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email / SMTP (optional) ----------------------------------------------
# Without SMTP configured, password reset and email verification stay
# disabled and the UI says so — email/password sign-in still works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Amellify <no-reply@example.com>

# --- AI schedule scanner (all optional — free-tier cascade) --------------
# Configure as many as you like; the cascade tries them in this order and
# skips any that are unset or rate-limited. See docs/AI-PROVIDERS.md for
# how to get each key for free and how to plug in your own OmniRoute/
# LiteLLM gateway instead.
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODELS=
MISTRAL_API_KEY=

# --- Docker Compose only (ignored by the app itself; read straight from
# `.env` by docker-compose.yml's `${VAR:-default}` interpolation) ---------
# Postgres credentials for the `db`/`migrate`/`app`/`backup` services.
# Change the password before going to production - see docs/DEPLOY.md.
POSTGRES_USER=amellify
POSTGRES_PASSWORD=amellify
POSTGRES_DB=amellify
# Domain (or free sslip.io hostname) Caddy requests an HTTPS cert for.
# Only used by the optional `proxy` profile - see docs/DEPLOY.md.
DOMAIN=localhost
ACME_EMAIL=admin@example.com
# Optional overrides for the `backup` profile's cron container (defaults:
# daily at 03:00 UTC, 14 days retention).
BACKUP_CRON="0 3 * * *"
BACKUP_RETENTION_DAYS=14

# --- Misc ------------------------------------------------------------------
NODE_ENV=development
