# Amellify — variables de entorno (copia a .env y ajusta)

PORT=3000
HOST=0.0.0.0
AMELLIFY_DB_PATH=./amellify.db
AMELLIFY_JWT_SECRET=cambiar-en-produccion

# Admin inicial (solo desarrollo / primer arranque)
AMELLIFY_ADMIN_EMAIL=admin@amellify.local
AMELLIFY_ADMIN_PASSWORD=admin

# Modo test (tests + E2E: enlaces de reset en consola, puerto aislado)
# AMELLIFY_TEST_MODE=1

# E2E Puppeteer (opcional; por defecto 30998)
# E2E_PORT=30998

# Web Push PWA (opcional — genera con: npx web-push generate-vapid-keys)
# Sin estas claves el cliente puede suscribirse pero el servidor no envía push programado.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google Calendar OAuth (opcional; alternativa: feed ICS en Configuración → Datos)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
